{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Server Manager",
  "version": "0.1.0",
  "identifier": "com.horizon.servermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Horizon Server Manager", "width": 1240, "height": 820, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://piston-meta.mojang.com https://piston-data.mojang.com https://api.papermc.io; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
